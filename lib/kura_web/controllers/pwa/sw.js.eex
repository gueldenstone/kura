// Kura service worker. Generated by KuraWeb.PwaController: do not edit a copy of this.
//
// Online, everything goes to the network as usual. The worker only steps in when the network is
// missing or too slow: navigations then get the offline screens, and assets come from the cache.

const CACHE = "<%= cache %>"
const PRECACHE = <%= precache %>
const OFFLINE = "/offline"
const NETWORK_TIMEOUT_MS = 3500
const DIGESTED = /-[0-9a-f]{32}\./
const STATIC_PREFIXES = ["/assets/", "/fonts/", "/images/", "/icon-", "/apple-touch-icon", "/manifest.webmanifest"]

self.addEventListener("install", event => {
  event.waitUntil(
    caches.open(CACHE)
      .then(async cache => {
        await Promise.all(PRECACHE.map(url => cache.add(url).catch(() => null)))
        // Without the offline screens there is no point in installing: try again next time.
        if (!(await cache.match(OFFLINE))) throw new Error("could not cache " + OFFLINE)
      })
      .then(() => self.skipWaiting())
  )
})

self.addEventListener("activate", event => {
  event.waitUntil(
    caches.keys()
      .then(keys => Promise.all(keys.filter(key => key !== CACHE).map(key => caches.delete(key))))
      .then(() => self.clients.claim())
  )
})

self.addEventListener("fetch", event => {
  const request = event.request
  if (request.method !== "GET") return

  const url = new URL(request.url)
  if (url.origin !== self.location.origin) return

  if (request.mode === "navigate") {
    event.respondWith(navigation(request))
  } else if (STATIC_PREFIXES.some(prefix => url.pathname.startsWith(prefix))) {
    event.respondWith(staticAsset(request))
  }
})

// A server that is down behind a reverse proxy answers 502-504 instead of failing to connect.
const unreachable = response => response.status >= 502 && response.status <= 504

const withTimeout = (promise, ms) =>
  Promise.race([promise, new Promise((_, reject) => setTimeout(() => reject(new Error("timeout")), ms))])

async function navigation(request) {
  try {
    const response = await withTimeout(fetch(request), NETWORK_TIMEOUT_MS)
    if (unreachable(response)) throw new Error("server unreachable")
    return response
  } catch (_error) {
    return (await caches.match(OFFLINE)) || Response.error()
  }
}

async function staticAsset(request) {
  // Digested files never change, so the cached copy is always right.
  if (DIGESTED.test(request.url)) {
    const hit = await caches.match(request)
    if (hit) return hit
  }

  const cache = await caches.open(CACHE)
  try {
    const response = await withTimeout(fetch(request), NETWORK_TIMEOUT_MS)
    if (response.ok) cache.put(request, response.clone())
    return response
  } catch (error) {
    const hit = await cache.match(request, {ignoreSearch: true})
    if (hit) return hit
    throw error
  }
}
